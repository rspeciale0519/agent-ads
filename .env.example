# Server-only Supabase connection. Never expose the secret key to the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-secret-key
# Temporary compatibility fallback. Remove it after SUPABASE_SECRET_KEY works.
# SUPABASE_SERVICE_ROLE_KEY=your-legacy-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=onboarding-assets

# Prisma runtime uses a login principal that inherits only the app_runtime permission role.
# Supavisor usernames include the project reference. Migrations use the direct URL.
# Keep pgbouncer=true and a conservative connection_limit for transaction pooling.
DATABASE_URL=postgresql://app_runtime_login.your-project-ref:password@aws-0-your-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=4&pool_timeout=10&sslmode=require&sslaccept=strict
DIRECT_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres?sslmode=require&sslaccept=strict
ACCOUNT_CONNECTIONS_ENABLED=false
ACCOUNT_CONNECTIONS_GOOGLE_ENABLED=false
ACCOUNT_CONNECTIONS_META_ENABLED=false
ACCOUNT_CONNECTIONS_TIKTOK_ENABLED=false
ACCOUNT_CONNECTIONS_DUBSADO_ENABLED=false
ACCOUNT_CONNECTIONS_WORDPRESS_ENABLED=false
ACCOUNT_CONNECTIONS_VIDEOASK_ENABLED=false
ACCOUNT_CONNECTIONS_ORGANIC_ENABLED=false
ACCOUNT_CONNECTIONS_ASSET_ENABLED=false
ACCOUNT_CONNECTIONS_GLOBAL_KILL_SWITCH=true
# Comma-separated organization UUIDs allowed to start or complete live provider access.
ACCOUNT_CONNECTIONS_ALLOWED_ORGANIZATION_IDS=
ACCOUNT_CONNECTIONS_MOCK_PROVIDER=false
# Set only after the isolated staging configuration check returns its safe target fingerprint.
STAGING_RUNTIME_TARGET_FINGERPRINT=
SECRET_BROKER_BACKEND=supabase-vault
SECRET_BROKER_KEY_VERSION=staging-v1
# This separate login principal inherits only the app_secret_broker permission role.
SECRET_BROKER_DATABASE_URL=postgresql://app_secret_broker_login.your-project-ref:password@aws-0-your-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=2&pool_timeout=10&sslmode=require&sslaccept=strict
SECRET_FINGERPRINT_KEY=replace-with-environment-secret
OAUTH_STATE_HMAC_KEY=replace-with-environment-secret
RATE_LIMIT_HMAC_KEY=replace-with-a-distinct-environment-secret
IDEMPOTENCY_HMAC_KEY=replace-with-a-distinct-environment-secret
ACCOUNT_CONNECTIONS_MAINTENANCE_TOKEN=replace-with-a-distinct-environment-secret
APP_BOOTSTRAP_AUTH_SUBJECT=
APP_BOOTSTRAP_ORGANIZATION_NAME=
APP_BOOTSTRAP_ORGANIZATION_SLUG=
# One-time controlled maintenance only; use a secret-manager-injected direct URL, never the runtime pooler.
APP_BOOTSTRAP_DATABASE_URL=

# Provider credentials stay environment-specific and are never used as a per-client token store.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Exact pre-registered HTTPS callback; runtime request hosts are never trusted.
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_ADS_API_VERSION=
GOOGLE_ADS_DEVELOPER_TOKEN=
META_APP_ID=
META_APP_SECRET=
# Exact pre-registered HTTPS callback; runtime request hosts are never trusted.
META_OAUTH_REDIRECT_URI=
META_GRAPH_API_VERSION=
TIKTOK_APP_ID=
TIKTOK_CLIENT_SECRET=
# Exact pre-registered HTTPS callback; runtime request hosts are never trusted.
TIKTOK_OAUTH_REDIRECT_URI=
# Must be an HTTPS endpoint on business-api.tiktok.com.
TIKTOK_AUTHORIZATION_ENDPOINT=
TIKTOK_REQUESTED_SCOPES=

# Browser-safe Supabase values used only to upload through short-lived signed URLs.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Add your deployed site URL and /auth/callback to Supabase Auth redirect URLs.

# Email delivery defaults off. Use resend-test only with official resend.dev test recipients.
EMAIL_DELIVERY_MODE=disabled
# Resend sender and the MioDio inbox that receives each submission.
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=MioDio onboarding <onboarding@your-verified-miodio-domain.com>
ONBOARDING_NOTIFICATION_EMAIL=delivered@resend.dev
